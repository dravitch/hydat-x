# Artefacts de données lourds — jamais versionnés (manifestés dans registry/datasets/)
data/raw/**
!data/raw/.gitkeep
data/canonical/**
!data/canonical/.gitkeep
data/reference/**
!data/reference/.gitkeep

# Sorties binaires / modèles / archives
*.zip
*.mdb
*.sqlite
*.sqlite3
*.db
*.parquet
*.feather
*.npz
*.npy
*.h5
*.gguf
*.onnx
*.safetensors
*.bin

# Artefacts analytiques dérivés (métadonnées de stations volumineuses)
metadata/stations/*
!metadata/stations/.gitkeep
!metadata/stations/hydat-schema.json
!metadata/stations/hydat-schema.txt
logs/

# Python / uv
__pycache__/
*.pyc
.pytest_cache/
.venv/
.mypy_cache/
.ruff_cache/

# Éditeurs / OS
.DS_Store